diff --git a/sonix-player/src/gui/library/playlistpage.c b/sonix-player/src/gui/library/playlistpage.c
index 6c4c300..e229df7 100755
--- a/sonix-player/src/gui/library/playlistpage.c
+++ b/sonix-player/src/gui/library/playlistpage.c
@@ -1211,10 +1211,50 @@ static void new_playlist_cb(lv_event_t *e) {
 // page checks, on the way in, whether anything it drew has moved since.
 static unsigned rows_revision;
 
+// The starred tracks, as the first row of the page: a list that is never made
+// or deleted by hand, the way the playlists below it are, but one that grows
+// as tracks are starred. The list itself is the library's (it is stored by file
+// path, so it does not need a scanned card).
+static void favourites_row_clicked_cb(lv_event_t *e) {
+	(void)e;
+	if (player_sheet_drag_active() || switcher_back_drag_active()) {
+		return; // a swipe across the list, not a tap
+	}
+	medialist_open(tr("favourites"), LIBRARY_LIST_FAVOURITES, LIBRARY_FILTER_NONE, NULL);
+}
+
 static void rebuild_rows(void) {
 	rows_revision = library_revision(LIBRARY_LIST_PLAYLIST);
 	lv_obj_clean(list);
 
+	// Favourites first. Not while picking a playlist for a track: that choice is
+	// among playlists, and a star has its own button.
+	if (!picking) {
+		lv_obj_t *fav_row = lv_btn_create(list);
+		lv_obj_set_size(fav_row, lv_pct(100), ROW_HEIGHT);
+		lv_obj_add_style(fav_row, &theme_style_card, 0);
+		lv_obj_add_style(fav_row, &theme_style_card_pressed, LV_STATE_PRESSED);
+		lv_obj_set_style_radius(fav_row, ROW_RADIUS, 0);
+		lv_obj_set_style_border_width(fav_row, 0, 0);
+		lv_obj_set_style_shadow_width(fav_row, 0, 0);
+		lv_obj_set_style_pad_hor(fav_row, 16, 0);
+		lv_obj_set_style_pad_column(fav_row, 14, 0);
+		lv_obj_set_flex_flow(fav_row, LV_FLEX_FLOW_ROW);
+		lv_obj_set_flex_align(fav_row, LV_FLEX_ALIGN_START, LV_FLEX_ALIGN_CENTER, LV_FLEX_ALIGN_CENTER);
+		lv_obj_set_event_bubble(fav_row, true); // the player sheet drags from here too
+		lv_obj_add_event_cb(fav_row, favourites_row_clicked_cb, LV_EVENT_CLICKED, NULL);
+
+		lv_obj_t *fav_icon = lv_image_create(fav_row);
+		lv_image_set_src(fav_icon, &icon_star_filled);
+		lv_obj_add_style(fav_icon, &theme_style_icon, 0);
+		lv_obj_set_style_image_recolor_opa(fav_icon, LV_OPA_COVER, 0);
+
+		lv_obj_t *fav_label = lv_label_create(fav_row);
+		lv_label_set_text(fav_label, tr("favourites"));
+		lv_obj_add_style(fav_label, &theme_style_text, 0);
+		lv_obj_set_style_text_font(fav_label, &font_ui_24, 0);
+	}
+
 	// The "new playlist" row comes first in both modes: it is the only way the
 	// first playlist can be made.
 	lv_obj_t *new_row = lv_btn_create(list);
