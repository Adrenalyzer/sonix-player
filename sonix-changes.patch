+
+// The playlists page, the way the Wi-Fi transfer page is opened from here: the
+// panel goes up, and if the player was over the page the sheet goes down first
+// and is put back when the page is left.
+static void playlists_clicked_cb(lv_event_t *e) {
+	(void)e;
+	quickpanel_close();
+	bool from_player = player_sheet_is_open();
+	if (from_player) {
+		player_sheet_close(false);
+	}
+	if (lv_screen_active() == playlistpage_screen) {
+		return; // already there: switching would record a step nobody took
+	}
+	playlistpage_open();
+	if (from_player) {
+		switcher_set_player_return(playlistpage_screen);
+	}
+}
+
+// The starred tracks, opened the same way. medialist_open() does nothing when
+// there is no card, so the player is only given a page to come back to if the
+// screen actually changed.
+static void favourites_clicked_cb(lv_event_t *e) {
+	(void)e;
+	quickpanel_close();
+	bool from_player = player_sheet_is_open();
+	if (from_player) {
+		player_sheet_close(false);
+	}
+	lv_obj_t *before = lv_screen_active();
+	medialist_open(tr("favourites"), LIBRARY_LIST_FAVOURITES, LIBRARY_FILTER_NONE, NULL);
+	if (from_player && lv_screen_active() != before) {
+		switcher_set_player_return(lv_screen_active());
+	}
+}
