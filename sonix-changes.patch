diff --git a/sonix-player/src/system/playback/workouttimer.c b/sonix-player/src/system/playback/workouttimer.c
new file mode 100644
index 0000000..ae290d5
--- /dev/null
+++ b/sonix-player/src/system/playback/workouttimer.c
@@ -0,0 +1,209 @@
+#include "workouttimer.h"
+
+#include <pthread.h>
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+
+#include "src/system/core/config.h"
+
+// A minute: a better first answer than nothing at all for somebody who presses
+// the button before visiting the settings.
+#define DEFAULT_SECONDS 60
+
+// The config stores names, not numbers, like the key map does.
+static const char *const SOUND_KEYS[CUE_COUNT] = {
+	[CUE_BEEP] = "beep",
+	[CUE_TRIPLE] = "triple",
+	[CUE_COUNTDOWN] = "countdown",
+	[CUE_ACK] = "ack", // never offered, but a name all the same
+};
+
+static pthread_mutex_t lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t wake;
+static bool thread_started;
+
+static int seconds = DEFAULT_SECONDS;
+static cue_sound_t sound = CUE_BEEP;
+static long long deadline_ms; // 0 while it is not counting
+static bool cued;			  // the cue for this run has been asked for
+static void (*listener)(bool fired);
+
+static long long now_ms(void) {
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (long long)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+static int clamp_seconds(int s) {
+	if (s < WORKOUTTIMER_MIN_SECONDS) {
+		return WORKOUTTIMER_MIN_SECONDS;
+	}
+	return s > WORKOUTTIMER_MAX_SECONDS ? WORKOUTTIMER_MAX_SECONDS : s;
+}
+
+static void notify(bool fired) {
+	void (*cb)(bool) = listener;
+	if (cb) {
+		cb(fired);
+	}
+}
+
+// Sleeps until the cue is due, asks for it, sleeps until the end, says so, and
+// starts the next interval from that end, over and over until it is stopped.
+// Woken early by every start and stop, and then simply works it out again from
+// the state as it stands.
+static void *timer_main(void *unused) {
+	(void)unused;
+	pthread_mutex_lock(&lock);
+	for (;;) {
+		if (!deadline_ms) {
+			pthread_cond_wait(&wake, &lock);
+			continue;
+		}
+
+		long long now = now_ms();
+		long long cue_at = deadline_ms - cue_lead_ms(sound);
+		if (!cued && now >= cue_at) {
+			cued = true;
+			cue_sound_t s = sound;
+			pthread_mutex_unlock(&lock);
+			if (!cue_play(s)) {
+				fprintf(stderr, "workouttimer: time is up, but there is no output to sound it on\n");
+			}
+			pthread_mutex_lock(&lock);
+			continue;
+		}
+		if (now >= deadline_ms) {
+			// The next interval begins where this one ended, not where the cue
+			// finished, so a long run does not drift. If the thread was held up
+			// for whole intervals, those are skipped rather than sounded at once.
+			long long step = (long long)seconds * 1000;
+			do {
+				deadline_ms += step;
+			} while (deadline_ms <= now);
+			cued = false;
+			printf("workouttimer: interval up, next in %d s\n", seconds);
+			pthread_mutex_unlock(&lock);
+			notify(true);
+			pthread_mutex_lock(&lock);
+			continue;
+		}
+
+		long long until = cued ? deadline_ms : cue_at;
+		struct timespec ts = {.tv_sec = (time_t)(until / 1000), .tv_nsec = (long)(until % 1000) * 1000000};
+		pthread_cond_timedwait(&wake, &lock, &ts);
+	}
+	return NULL;
+}
+
+void workouttimer_init(void) {
+	seconds = clamp_seconds((int)config_get_int("workout", "seconds", DEFAULT_SECONDS));
+	const char *name = config_get("workout", "sound", SOUND_KEYS[CUE_BEEP]);
+	sound = CUE_BEEP;
+	for (int i = 0; i < CUE_COUNT; i++) {
+		if (i != CUE_ACK && name && strcmp(name, SOUND_KEYS[i]) == 0) {
+			sound = (cue_sound_t)i;
+		}
+	}
+
+	if (thread_started) {
+		return;
+	}
+	// The deadline is a CLOCK_MONOTONIC reading, so the wait has to be on that
+	// clock too: on the default one, setting the time would move the beep.
+	pthread_condattr_t attr;
+	pthread_condattr_init(&attr);
+	pthread_condattr_setclock(&attr, CLOCK_MONOTONIC);
+	pthread_cond_init(&wake, &attr);
+	pthread_condattr_destroy(&attr);
+
+	pthread_t thread;
+	pthread_attr_t tattr;
+	pthread_attr_init(&tattr);
+	pthread_attr_setdetachstate(&tattr, PTHREAD_CREATE_DETACHED);
+	thread_started = pthread_create(&thread, &tattr, timer_main, NULL) == 0;
+	pthread_attr_destroy(&tattr);
+	if (!thread_started) {
+		fprintf(stderr, "workouttimer: could not start its thread\n");
+	}
+}
+
+int workouttimer_seconds(void) { return seconds; }
+
+void workouttimer_set_seconds(int s) {
+	s = clamp_seconds(s);
+	if (s == seconds) {
+		return;
+	}
+	seconds = s;
+	config_set_int("workout", "seconds", s);
+	config_save();
+}
+
+cue_sound_t workouttimer_sound(void) { return sound; }
+
+void workouttimer_set_sound(cue_sound_t s) {
+	if (s < 0 || s >= CUE_COUNT || s == CUE_ACK || s == sound) {
+		return;
+	}
+	pthread_mutex_lock(&lock);
+	sound = s;
+	pthread_cond_signal(&wake); // a countdown's pips start earlier than a beep
+	pthread_mutex_unlock(&lock);
+	config_set("workout", "sound", SOUND_KEYS[s]);
+	config_save();
+}
+
+bool workouttimer_start(void) {
+	if (!thread_started) {
+		return false;
+	}
+	pthread_mutex_lock(&lock);
+	deadline_ms = now_ms() + (long long)seconds * 1000;
+	cued = false;
+	pthread_cond_signal(&wake);
+	pthread_mutex_unlock(&lock);
+	printf("workouttimer: %d s\n", seconds);
+
+	// Heard rather than seen: the press usually comes from a pocket.
+	cue_play(CUE_ACK);
+	notify(false);
+	return true;
+}
+
+bool workouttimer_toggle(void) {
+	if (workouttimer_running()) {
+		workouttimer_stop();
+		cue_play(CUE_ACK); // heard rather than seen, as the start is
+		return false;
+	}
+	return workouttimer_start();
+}
+
+void workouttimer_stop(void) {
+	pthread_mutex_lock(&lock);
+	bool was = deadline_ms != 0;
+	deadline_ms = 0;
+	pthread_cond_signal(&wake);
+	pthread_mutex_unlock(&lock);
+	if (was) {
+		notify(false);
+	}
+}
+
+bool workouttimer_running(void) {
+	pthread_mutex_lock(&lock);
+	bool running = deadline_ms != 0;
+	pthread_mutex_unlock(&lock);
+	return running;
+}
+
+int workouttimer_remaining(void) {
+	pthread_mutex_lock(&lock);
+	long long left = deadline_ms ? deadline_ms - now_ms() : 0;
+	pthread_mutex_unlock(&lock);
+	return left > 0 ? (int)((left + 999) / 1000) : 0;
+}
+
+void workouttimer_set_listener(void (*cb)(bool fired)) { listener = cb; }
diff --git a/sonix-player/src/system/playback/workouttimer.h b/sonix-player/src/system/playback/workouttimer.h
new file mode 100644
index 0000000..cd1816c
--- /dev/null
+++ b/sonix-player/src/system/playback/workouttimer.h
@@ -0,0 +1,69 @@
+#ifndef WORKOUTTIMER_H
+#define WORKOUTTIMER_H
+
+#include <stdbool.h>
+
+#include "src/system/audio/cue.h"
+
+// The workout timer: a countdown that sounds a cue when it runs out, laid over
+// whatever is playing (cue.h), for the rest between two sets.
+//
+// It is not a sleep timer and shares none of its rules. Nothing stops: the
+// music carries on under the beep. It counts from the moment it is started,
+// playing or not, because the interval it measures does not care whether the
+// music is paused. And it repeats: having sounded, the next interval begins at
+// once, and so on until it is stopped -- from the control centre, or from a
+// side button mapped to it (keymap.h), which is how it is meant to be used with
+// the player in a pocket. A press of that button starts it, and the next press
+// stops it (workouttimer_toggle). Starting it while it counts starts it over
+// from the full length.
+//
+// A running timer keeps the player awake (power.c): forgotten, it runs the
+// battery down.
+//
+// The countdown runs on a thread of its own against the monotonic clock, so a
+// dark screen, which slows the interface's timers to a crawl, does not make the
+// beep late; and power.c will not suspend the player under a running one.
+//
+// The length and the sound are kept in [workout]; whether it is counting is
+// not kept anywhere, since a timer that survived a restart would sound at a
+// moment that no longer means anything.
+
+// Not less than the countdown's three seconds of pips and its long note, or
+// one interval's cue would still be sounding when the next began.
+#define WORKOUTTIMER_MIN_SECONDS 5
+#define WORKOUTTIMER_MAX_SECONDS (59 * 60 + 59)
+
+// Reads the config and starts the thread. Once, at startup.
+void workouttimer_init(void);
+
+// The length, in seconds, never under WORKOUTTIMER_MIN_SECONDS: a rest of no
+// length is no rest, so nothing can set one, a hand-edited config included.
+int workouttimer_seconds(void);
+void workouttimer_set_seconds(int seconds);
+
+cue_sound_t workouttimer_sound(void);
+void workouttimer_set_sound(cue_sound_t sound);
+
+// Any thread. Starts it, or starts it over, at the chosen length, with a short
+// blip to say so. False only when its thread could not be made.
+bool workouttimer_start(void);
+
+// Any thread. Stops it without a sound.
+void workouttimer_stop(void);
+
+// Any thread. Starts it if it is not counting, and stops it, with a blip, if it
+// is. True when it is counting afterwards.
+bool workouttimer_toggle(void);
+
+bool workouttimer_running(void);
+
+// What is left, in whole seconds rounded up; 0 when it is not counting.
+int workouttimer_remaining(void);
+
+// Told of every change: started, stopped, and run out (`fired`). Called on
+// whichever thread made the change -- the button thread, the timer's own --
+// so the listener must not touch the interface directly.
+void workouttimer_set_listener(void (*cb)(bool fired));
+
+#endif /* WORKOUTTIMER_H */
